{
  "name": "doconline-office",
  "version": "1.1.0",
  "description": "Editor de documentos tipo Word para React y Next.js: hojas reales, encabezado y pie de página, tablas, exportación a .docx y PDF",
  "license": "MIT",
  "author": "Carlos Leon",
  "homepage": "https://github.com/leonxn/DocOnline-Office#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonxn/DocOnline-Office.git"
  },
  "bugs": {
    "url": "https://github.com/leonxn/DocOnline-Office/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "editor",
    "word",
    "docx",
    "rich-text",
    "wysiwyg",
    "tiptap",
    "documento",
    "office"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start -p 3005",
    "build:lib": "tsup",
    "prepare": "tsup",
    "prepublishOnly": "tsc --noEmit -p . && tsup"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@google/genai": "^2.30.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.11.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.57.0",
    "mammoth": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
